digraph DFA {
    rankdir=LR;
    node [shape = circle];
    A [shape=circle];
    B [shape=circle];
    C [shape=doublecircle];
    D [shape=doublecircle];
    E [shape=doublecircle];
    F [shape=circle];
    G [shape=doublecircle];
    A -> B [label="a"];
    B -> B [label="a"];
    B -> C [label="b"];
    C -> D [label="a"];
    C -> E [label="b"];
    D -> F [label="a"];
    D -> C [label="b"];
    E -> G [label="a"];
    E -> E [label="b"];
    F -> F [label="a"];
    F -> C [label="b"];
    G -> B [label="a"];
    G -> C [label="b"];
}